# Copy to a private .env.free file for a new Free instance. Never use an existing production .env.
MODEL_API_KEY=replace-with-your-provider-key
AUTH_PASSWORD=replace-with-a-random-32-byte-or-longer-secret

# Optional independent search BYOK; neither value falls back to MODEL_API_KEY.
# WEB_SEARCH_PROVIDER=exa
# WEB_SEARCH_API_KEY=replace-with-your-search-key

# Optional independent inbound events; first initialize a ready Companion and set
# COMPANION_SESSION_ID in private Wrangler config. See docs/inbound-integrations.md.
# CHAT_INTEGRATIONS={"keet":{"webhookToken":"synthetic-receiver-token","aliases":["Companion"]},"matrix":{"webhookToken":"synthetic-matrix-token","selfUserId":"@companion:example.invalid"}}
# Optional generic tools independently use MCP_CONFIG with the Free singleton key.
# MCP_CONFIG={"singleton":[{"name":"notes","url":"https://operator-selected.example/mcp"}]}
