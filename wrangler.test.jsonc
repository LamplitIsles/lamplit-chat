{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamplit-free-test",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "main": "src/server-test-entry.ts",
  "vars": {
    "MODEL_PROVIDER": "openrouter",
    "AI_MODEL": "openai/gpt-4o",
    "MODEL_THINKING_LEVEL": "",
    "MODEL_MAX_OUTPUT_TOKENS": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "PiSession", "class_name": "PiSession" },
      { "name": "PiRegistry", "class_name": "PiRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PiRegistry"] }
  ],
  "r2_buckets": [{ "binding": "COMPUTER_R2", "bucket_name": "photo-test-owned" }]
}
