{
  "name": "pi-on-cf",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "npm run build --prefix frontend && wrangler dev",
    "build": "npm run build --prefix frontend",
    "check:frontend": "npm run check --prefix frontend",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.3.1",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.24.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.1",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.143.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
