{
  "name": "@pi-on-cf/companion",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "paraglide:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy globalVariable preferredLanguage baseLocale --silent",
    "precheck": "npm run paraglide:generate",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.1",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@humanspeak/svelte-markdown": "^1.8.5",
    "@inlang/paraglide-js": "^2.25.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.12",
    "daisyui": "^5.7.46",
    "katex": "^0.16.47",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "svelte-check": "^4.7.6"
  }
}
