{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamplit-free",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../lamplit-app/apps/web/build",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "MODEL_PROVIDER": "openrouter",
    "AI_MODEL": "openai/gpt-4o",
    "MODEL_THINKING_LEVEL": "",
    "MODEL_MAX_OUTPUT_TOKENS": "",
    "PI_SYSTEM_PROMPT": "",
    "COMPANION_SESSION_ID": ""
  },
  "secrets": { "required": ["MODEL_API_KEY", "AUTH_PASSWORD"] },
  "durable_objects": {
    "bindings": [
      { "name": "PiSession", "class_name": "PiSession" },
      { "name": "PiRegistry", "class_name": "PiRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PiRegistry"] }
  ],
  "observability": { "enabled": true }
}
